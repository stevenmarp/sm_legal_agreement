<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Preview Wizard Form View -->
        <record id="sm_document_preview_wizard_view_form" model="ir.ui.view">
            <field name="name">sm.document.preview.wizard.view.form</field>
            <field name="model">sm.document.preview.wizard</field>
            <field name="arch" type="xml">
                <form string="Template Preview">
                    <group>
                        <field name="template_id" readonly="1"/>
                        <field name="use_real_record"/>
                        <field name="record_id" attrs="{'invisible': [('use_real_record', '=', False)]}"/>
                    </group>
                    <separator string="Preview"/>
                    <div class="border rounded p-3 bg-white" style="min-height: 400px;">
                        <field name="preview_content" readonly="1" widget="html" nolabel="1"/>
                    </div>
                    <footer>
                        <button name="action_print_pdf" string="Print PDF" type="object" class="btn-primary" icon="fa-print"/>
                        <button string="Close" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action for Preview Wizard -->
        <record id="sm_document_preview_wizard_action" model="ir.actions.act_window">
            <field name="name">Preview Template</field>
            <field name="res_model">sm.document.preview.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
