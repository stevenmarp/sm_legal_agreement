<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Module Category -->
        <record id="module_category_document_templates" model="ir.module.category">
            <field name="name">Document Templates</field>
            <field name="description">Category for document template management</field>
            <field name="sequence">50</field>
        </record>

        <!-- Privilege (Odoo 19 style) -->
        <record id="privilege_document_template" model="res.groups.privilege">
            <field name="name">Document Templates</field>
            <field name="description">Manage document templates and legal agreements</field>
            <field name="category_id" ref="module_category_document_templates"/>
            <field name="sequence">10</field>
        </record>

        <!-- Security Groups using privilege_id -->
        <record id="group_document_template_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_document_template"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_document_template_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_document_template"/>
            <field name="implied_ids" eval="[(4, ref('group_document_template_user'))]"/>
        </record>

    </data>
</odoo>
