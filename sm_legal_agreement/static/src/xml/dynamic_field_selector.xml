<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="DynamicFieldSelectorChar">
        <span class="o_field_dynamic_selector"/>
    </t>

    <t t-name="DynamicFieldSelectorChar.edit">
        <div class="o_field_dynamic_selector position-relative">
            <input 
                type="text"
                class="o_input"
                t-att-value="value"
                t-att-placeholder="placeholder"
            />
            <div t-if="loading" class="position-absolute" style="right: 10px; top: 50%; transform: translateY(-50%);">
                <i class="fa fa-spinner fa-spin text-muted"/>
            </div>
            <div t-if="showSuggestions &amp;&amp; suggestions.length" 
                 class="o_field_selector_suggestions position-absolute bg-white border rounded shadow-sm"
                 style="top: 100%; left: 0; right: 0; z-index: 1000; max-height: 200px; overflow-y: auto;">
                <t t-foreach="suggestions" t-as="suggestion">
                    <div class="p-2 cursor-pointer hover-bg-light d-flex justify-content-between align-items-center o_suggestion_item"
                         t-att-data-name="suggestion.name"
                         style="cursor: pointer;">
                        <div>
                            <strong><t t-esc="suggestion.name"/></strong>
                            <small class="text-muted d-block"><t t-esc="suggestion.label"/></small>
                        </div>
                        <span class="badge badge-secondary"><t t-esc="suggestion.type"/></span>
                    </div>
                </t>
            </div>
        </div>
    </t>

</templates>
